# ── Snowflake ─────────────────────────────────────────────────────
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_ACCOUNT=QYCMQJK-HTC96121

# Path to your RSA private key file (never expires, unlike tokens)
SNOWFLAKE_PRIVATE_KEY_PATH=snowflake_private_key.pem

# Only needed if your private key was generated with a passphrase
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Override these to point at a different environment (defaults shown)
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=EQUITY_ANALYTICS
SNOWFLAKE_SCHEMA=MARTS

# ── Airflow ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AIRFLOW_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Admin user credentials for the Airflow UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=you@example.com
AIRFLOW_ADMIN_PASSWORD=replace-with-strong-password

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── FRED (Federal Reserve economic data) ──────────────────────────
# Free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here
