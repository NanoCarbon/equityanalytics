# Snowflake
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_TOKEN=your_programmatic_access_token

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# FRED API
FRED_API_KEY=your_fred_api_key_here

# Airflow — set strong unique values before running docker-compose up
# CRITICAL: if docker-compose.yml was committed to a public repo with default
# credentials (airflow/airflow, admin/admin), rotate these immediately and
# restart the stack.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_strong_password
AIRFLOW_SECRET_KEY=change_me_random_secret_key_32chars
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin_password